{
  "name": "tragge",
  "version": "0.0.1",
  "private": true,
  "description": "Trading Tournament Platform - Monorepo",
  "scripts": {
    "baseline:inventory": "node scripts/production-baseline.mjs inventory",
    "baseline:verify": "node scripts/production-baseline.mjs verify",
    "test:baseline": "node scripts/production-baseline.test.mjs",
    "validate:sec006": "node scripts/sec-006-edge-security-check.mjs",
    "test:sec006": "node --test scripts/sec-006-edge-security-check.test.mjs",
    "validate:payment4-retirement": "node scripts/payment4-retirement-check.mjs",
    "test:payment4-retirement": "node --test scripts/payment4-retirement-check.test.mjs",
    "validate:sec007": "node scripts/sec-007-super-admin-mfa-check.mjs",
    "test:sec007": "node --test scripts/sec-007-super-admin-mfa-check.test.mjs",
    "test:doc001": "node --test scripts/codex/doc-001-claude-status.test.mjs",
    "test:sec008": "node --test scripts/sec-008-auth-regression-lock.test.mjs",
    "test:sec009": "node --test scripts/sec-009-admin-reauth-mfa.test.mjs",
    "test:infra002": "node --test scripts/k8s-overlay-parity.test.mjs",
    "test:fin001": "node --test scripts/sec-fin001-platform-fee-check.test.mjs",
    "test:fin002": "node --test scripts/sec-fin002-prize-path-check.test.mjs",
    "test:fin003": "node --test scripts/sec-fin003-finalization-owner.test.mjs",
    "test:fin004": "node --test scripts/sec-fin004-tralent-v1-check.test.mjs",
    "test:fin005": "node --test scripts/sec-fin005-reconciliation-harness.test.mjs",
    "test:lifecycle001": "node --test scripts/sec-lifecycle001-late-entry.test.mjs",
    "test:lifecycle002": "node --test scripts/sec-lifecycle002-capacity.test.mjs",
    "test:lifecycle003": "node --test scripts/sec-lifecycle003-archival.test.mjs",
    "dev": "echo 'Run individual frontend apps with pnpm --filter <app> dev'",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:user": "playwright test --project=user-chromium",
    "e2e:trade": "playwright test --project=trade-chromium",
    "e2e:admin": "playwright test --project=admin-chromium",
    "e2e:firefox": "playwright test --project=firefox",
    "e2e:report": "playwright show-report",
    "e2e:install": "playwright install --with-deps"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0",
    "pnpm": "8.15.0"
  },
  "packageManager": "pnpm@8.15.0"
}
